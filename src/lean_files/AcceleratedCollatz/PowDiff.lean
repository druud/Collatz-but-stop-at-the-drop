/-! ### Helpers for the generated checks (`run_cmd` below) -/

theorem forall_lt_zero {P : ℕ → Prop} : ∀ k, k < 0 → P k :=
  fun _ h => absurd h (Nat.not_lt_zero _)

theorem forall_lt_succ {P : ℕ → Prop} {n : ℕ} (h : ∀ k, k < n → P k) (hn : P n) :
    ∀ k, k < n + 1 → P k :=
  fun k hk => (Nat.lt_succ_iff_lt_or_eq.mp hk).elim (h k) fun e => e ▸ hn

theorem all_append_true {α : Type} {f : α → Bool} {l₁ l₂ : List α} (h₁ : l₁.all f = true)
    (h₂ : l₂.all f = true) : (l₁ ++ l₂).all f = true := by
  rw [List.all_append, h₁, h₂, Bool.and_self]

/-- A witness is right: D(2^i, 3^j) = v. -/
def okW (w : ℕ × ℕ × ℕ) : Bool := D (2 ^ w.2.1) (3 ^ w.2.2) = w.1

/-! The 30 parts, one check each, then their conjunction. -/

open Lean Elab Command in
run_cmd
  for k in [0:30] do
    elabCommand (← `(theorem $(mkIdent (.mkSimple s!"witnesses_ok_{k}")) :
      $(mkIdent (.mkSimple s!"witnesses_{k}")).all okW = true := by decide +kernel))
  let mut t : Term := mkIdent `witnesses_ok_29
  for k in (List.range 29).reverse do
    t ← `(all_append_true $(mkIdent (.mkSimple s!"witnesses_ok_{k}")) $t)
  elabCommand (← `(set_option maxRecDepth 10000 in
    theorem $(mkIdent `witnesses_ok) : witnesses.all okW = true := by
    unfold witnesses; exact $t))

theorem terms_zero : terms 0 = table0 := by decide +kernel

theorem terms_one : terms 1 = table1 := by decide +kernel

theorem table0_length : table0.length = 3000 := by decide +kernel

theorem table1_length : table1.length = 2891 := by decide +kernel

theorem table0_sorted : table0.Pairwise (· < ·) :=
  List.isChain_iff_pairwise.mp (by decide +kernel)

theorem table1_sorted : table1.Pairwise (· < ·) :=
  List.isChain_iff_pairwise.mp (by decide +kernel)

/-- Every table entry is a term. -/
theorem isPowDiff_of_mem {lo v : ℕ} (h : v ∈ terms lo) : IsPowDiff lo v := by
  unfold terms at h
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp h
  obtain ⟨hw1, hlo⟩ := List.mem_filter.mp hw
  rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at hlo
  have hok := List.all_eq_true.mp witnesses_ok w hw1
  unfold okW at hok
  rw [decide_eq_true_eq] at hok
  exact ⟨w.2.1, w.2.2, hlo.1, hlo.2, by rw [natAbs_eq_D, hok]⟩

theorem terms_one_subset {lo v : ℕ} (hlo : lo ≤ 1) (h : v ∈ terms 1) : v ∈ terms lo := by
  unfold terms at h ⊢
  obtain ⟨w, hw, rfl⟩ := List.mem_map.mp h
  obtain ⟨hw1, h1⟩ := List.mem_filter.mp hw
  rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq] at h1
  refine List.mem_map.mpr ⟨w, List.mem_filter.mpr ⟨hw1, ?_⟩, rfl⟩
  rw [Bool.and_eq_true, decide_eq_true_eq, decide_eq_true_eq]
  omega

/-! ### The periods mod M -/

set_option exponentiation.threshold 2000 in
/-- 2^i ≡ 2^(8 + (i - 8) % 288) (mod M) for i ≥ 8. -/
theorem two_pow_modEq {i : ℕ} (hi : 8 ≤ i) : 2 ^ i ≡ 2 ^ (8 + (i - 8) % 288) [MOD M] := by
  have h288 : 2 ^ 288 ≡ 1 [MOD 6300149066901619698922335] := by decide +kernel
  have hk := (h288.pow ((i - 8) / 288)).mul_left' 256
  rw [one_pow] at hk
  have hM : M = 256 * 6300149066901619698922335 := by decide
  rw [hM]
  have he : i = 8 + (i - 8) % 288 + 288 * ((i - 8) / 288) := by omega
  have hr := hk.mul_right (2 ^ ((i - 8) % 288))
  calc 2 ^ i = 256 * (2 ^ 288) ^ ((i - 8) / 288) * 2 ^ ((i - 8) % 288) := by
        conv_lhs => rw [he]
        rw [pow_add, pow_add, pow_mul]
        ring
    _ ≡ 256 * 1 * 2 ^ ((i - 8) % 288) [MOD 256 * 6300149066901619698922335] := hr
    _ = 2 ^ (8 + (i - 8) % 288) := by rw [pow_add]; ring

set_option exponentiation.threshold 2000 in
/-- 3^j ≡ 3^(3 + (j - 3) % 1728) (mod M) for j ≥ 3. -/
theorem three_pow_modEq {j : ℕ} (hj : 3 ≤ j) : 3 ^ j ≡ 3 ^ (3 + (j - 3) % 1728) [MOD M] := by
  have h1728 : 3 ^ 1728 ≡ 1 [MOD 59734746708400542330522880] := by decide +kernel
  have hk := (h1728.pow ((j - 3) / 1728)).mul_left' 27
  rw [one_pow] at hk
  have hM : M = 27 * 59734746708400542330522880 := by decide
  rw [hM]
  have he : j = 3 + (j - 3) % 1728 + 1728 * ((j - 3) / 1728) := by omega
  have hr := hk.mul_right (3 ^ ((j - 3) % 1728))
  calc 3 ^ j = 27 * (3 ^ 1728) ^ ((j - 3) / 1728) * 3 ^ ((j - 3) % 1728) := by
        conv_lhs => rw [he]
        rw [pow_add, pow_add, pow_mul]
        ring
    _ ≡ 27 * 1 * 3 ^ ((j - 3) % 1728) [MOD 27 * 59734746708400542330522880] := hr
    _ = 3 ^ (3 + (j - 3) % 1728) := by rw [pow_add]; ring

/-! ### The checks -/

/-- The residue c of x - y mod M (x, y < M): c itself, or M - c, is in `table1` when it is
    at most N. -/
def pairOK (x y : ℕ) : Bool :=
  let c := (x + M - y) % M
  (!decide (c ≤ N) || table1.contains c) && (!decide (M - c ≤ N) || table1.contains (M - c))

/-- The residues of 3^j, 3 ≤ j < 1731. -/
def ys : List ℕ := (List.range 1728).map fun s => 3 ^ (3 + s) % M

/-- The residue classes 8 + a ≤ i < 8 + a + n, j ≥ 3. -/
def regionOK (n a : ℕ) : Bool :=
  (List.range n).all fun r => ys.all fun y => pairOK (2 ^ (8 + (a + r)) % M) y

/-! The 288 classes of i in 144 parts of 2, checked in parallel (one part of 18 took 9 GB). -/

/-! The 144 parts `regionOK_k`, k < 144, one check each, and `regionOK_part`. -/
open Lean Elab Command in
run_cmd
  let mut t : Term ← `(forall_lt_zero)
  for k in [0:144] do
    let n := mkIdent (.mkSimple s!"regionOK_{k}")
    elabCommand (← `(set_option maxRecDepth 100000 in
      theorem $n : regionOK 2 (2 * $(Syntax.mkNumLit (toString k))) = true := by decide +kernel))
    t ← `(forall_lt_succ $t $n)
  elabCommand (← `(set_option maxRecDepth 10000 in
    theorem $(mkIdent `regionOK_part) : ∀ k, k < 144 → regionOK 2 (2 * k) = true := $t))

/-- Every class i ≥ 8, j ≥ 3 passes the check. -/
theorem pairOK_region {r y : ℕ} (hr : r < 288) (hy : y ∈ ys) :
    pairOK (2 ^ (8 + r) % M) y = true := by
  have h := List.all_eq_true.mp (regionOK_part (r / 2) (by omega)) (r % 2)
    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have h2 := List.all_eq_true.mp h y hy
  rwa [Nat.div_add_mod] at h2

/-- The pairs (i, j), j < 44, with i, j ≥ lo, against table t: one row i. -/
def smallRow (lo : ℕ) (t : List ℕ) (i : ℕ) : Bool :=
  (List.range 44).all fun j =>
    !(decide (lo ≤ i) && decide (lo ≤ j)) || !decide (D (2 ^ i) (3 ^ j) ≤ N) ||
      t.contains (D (2 ^ i) (3 ^ j))

/-! The rows i < 69, one check each (all 69 in one check took more than 12 GB). -/

/-! The rows `smallOK_zero_i`, `smallOK_one_i`, i < 69, one check each, and `smallOK_zero`,
    `smallOK_one`. -/
open Lean Elab Command in
run_cmd
  for (lo, tab, nm) in [(0, `table0, "zero"), (1, `table1, "one")] do
    let mut t : Term ← `(forall_lt_zero)
    for i in [0:69] do
      let n := mkIdent (.mkSimple s!"smallOK_{nm}_{i}")
      elabCommand (← `(theorem $n : smallRow $(Syntax.mkNumLit (toString lo)) $(mkIdent tab)
        $(Syntax.mkNumLit (toString i)) = true := by decide +kernel))
      t ← `(forall_lt_succ $t $n)
    elabCommand (← `(set_option maxRecDepth 10000 in
      theorem $(mkIdent (.mkSimple s!"smallOK_{nm}")) : ∀ i, i < 69 →
        smallRow $(Syntax.mkNumLit (toString lo)) $(mkIdent tab) i = true := $t))

/-! ### The terms up to N -/

/-- The residue of x - y mod M, from x' ≡ x and y' ≡ y, gives |x - y| ≤ N. -/
theorem mem_of_pairOK {x y x' y' : ℕ} (hx : x ≡ x' [MOD M]) (hy : y ≡ y' [MOD M])
    (hD : D x y ≤ N) (h : pairOK (x' % M) (y' % M) = true) : D x y ∈ table1 := by
  unfold pairOK at h
  rw [← hx, ← hy] at h
  simp only [Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
    not_le, List.contains_iff_mem] at h
  unfold D at hD ⊢
  unfold M N at *
  rcases le_total y x with hyx | hxy
  · have hc : (x % 1612838161126814642924117760 + 1612838161126814642924117760 -
        y % 1612838161126814642924117760) % 1612838161126814642924117760 = x - y := by omega
    rw [hc] at h
    rw [Nat.sub_eq_zero_of_le hyx, Nat.add_zero]
    rcases h.1 with h1 | h1
    · omega
    · exact h1
  · rcases Nat.eq_or_lt_of_le hxy with he | hlt
    · subst he
      have hc : (x % 1612838161126814642924117760 + 1612838161126814642924117760 -
          x % 1612838161126814642924117760) % 1612838161126814642924117760 = x - x := by omega
      rw [hc] at h
      simp only [Nat.sub_self, Nat.add_zero]
      rcases h.1 with h1 | h1
      · omega
      · simpa using h1
    · have hc : (x % 1612838161126814642924117760 + 1612838161126814642924117760 -
          y % 1612838161126814642924117760) % 1612838161126814642924117760 =
          1612838161126814642924117760 - (y - x) := by omega
      rw [hc] at h
      rw [Nat.sub_eq_zero_of_le hxy, Nat.zero_add]
      rcases h.2 with h2 | h2
      · omega
      · have he : 1612838161126814642924117760 - (1612838161126814642924117760 - (y - x)) =
            y - x := by omega
        rwa [he] at h2

/-- v ≤ N is |2^i - 3^j| with i, j ≥ lo exactly when it is in `terms lo` (lo ≤ 1). -/
theorem isPowDiff_iff {lo v : ℕ} (hlo : lo ≤ 1) (hv : v ≤ N) :
    IsPowDiff lo v ↔ v ∈ terms lo := by
  refine ⟨fun ⟨i, j, hi, hj, he⟩ => ?_, isPowDiff_of_mem⟩
  rw [natAbs_eq_D] at he
  subst he
  by_cases hreg : 8 ≤ i ∧ 3 ≤ j
  · apply terms_one_subset hlo
    rw [terms_one]
    have hs := pairOK_region (Nat.mod_lt (i - 8) (by decide : 0 < 288))
      (List.mem_map.mpr ⟨(j - 3) % 1728, List.mem_range.mpr (Nat.mod_lt _ (by decide)), rfl⟩)
    exact mem_of_pairOK (two_pow_modEq hreg.1) (three_pow_modEq hreg.2) hv hs
  · have hb : i < 69 ∧ j < 44 := by
      unfold D N at hv
      rcases not_and_or.mp hreg with h8 | h3
      · have h2 : 2 ^ i ≤ 2 ^ 7 := Nat.pow_le_pow_right (by decide) (by omega)
        have h3j : 3 ^ j < 3 ^ 44 := by norm_num at h2 ⊢; omega
        exact ⟨by omega, (Nat.pow_lt_pow_iff_right (by decide)).mp h3j⟩
      · have h2 : 3 ^ j ≤ 3 ^ 2 := Nat.pow_le_pow_right (by decide) (by omega)
        have h2i : 2 ^ i < 2 ^ 69 := by norm_num at h2 ⊢; omega
        exact ⟨(Nat.pow_lt_pow_iff_right (by decide)).mp h2i, by omega⟩
    have hr : smallRow lo (terms lo) i = true := by
      rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hlo with rfl | rfl
      · rw [terms_zero]; exact smallOK_zero i hb.1
      · rw [terms_one]; exact smallOK_one i hb.1
    unfold smallRow at hr
    have hs := List.all_eq_true.mp hr j (List.mem_range.mpr hb.2)
    simp only [Bool.or_eq_true, Bool.not_eq_true', Bool.and_eq_false_iff,
      decide_eq_false_iff_not, not_le, List.contains_iff_mem] at hs
    rcases hs with (h | h) | h
    · omega
    · omega
    · exact h

/-- A014121 up to its 3000th term: v ≤ N is |2^i - 3^j| for some i, j ≥ 0 exactly when
    v ∈ `table0` (3000 terms, increasing). -/
theorem a014121_iff {v : ℕ} (hv : v ≤ N) : IsPowDiff 0 v ↔ v ∈ table0 := by
  rw [← terms_zero]
  exact isPowDiff_iff (by decide) hv

/-- A363999 up to N: v ≤ N is |2^i - 3^j| for some i, j ≥ 1 exactly when v ∈ `table1`
    (2891 terms, increasing). -/
theorem a363999_iff {v : ℕ} (hv : v ≤ N) : IsPowDiff 1 v ↔ v ∈ table1 := by
  rw [← terms_one]
  exact isPowDiff_iff le_rfl hv

